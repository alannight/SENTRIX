# ─── Local Development ────────────────────────────────────────────────────────
# Copy this file to .env and replace the values before running.

# PostgreSQL (used by compose.yaml and the backend)
POSTGRES_DB=sentrix
POSTGRES_USER=sentrix
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://sentrix:change-me-local-only@localhost:5432/sentrix

# Backend settings
SENTRIX_APP_ENV=development
SENTRIX_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SENTRIX_MAX_REQUEST_BYTES=262144
SENTRIX_DB_POOL_SIZE=5
SENTRIX_DB_MAX_OVERFLOW=5
SENTRIX_DB_POOL_TIMEOUT_SECONDS=30
# Zero disables automatic retention. Set a positive integer to enable cleanup.
SENTRIX_EVENT_RETENTION_DAYS=0

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# ─── Docker compose (full stack) ──────────────────────────────────────────────
# When running via `docker compose up`, the backend container connects to the
# internal network. Change the DATABASE_URL host to "db" (the service name).
#
# DATABASE_URL=postgresql+psycopg://sentrix:change-me-local-only@db:5432/sentrix
# SENTRIX_CORS_ORIGINS=http://localhost:3000
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
